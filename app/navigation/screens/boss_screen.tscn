[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://app/navigation/navigable_screen.gd" id="1_screen"]
[ext_resource type="Theme" path="res://ui/components/theme/app_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://stages/boards/board_mockup_2d.tscn" id="3_board"]

[node name="BossScreen" type="Node2D"]
script = ExtResource("1_screen")
screen_id = &"boss"
progression_action = &"wave_cleared"
next_button_path = NodePath("Overlay/Content/NextButton")

[node name="BoardMockup2D" parent="." instance=ExtResource("3_board")]
position = Vector2(640, 382)
show_boss = true

[node name="Overlay" type="CanvasLayer" parent="."]

[node name="Content" type="VBoxContainer" parent="Overlay"]
offset_left = 32.0
offset_top = 32.0
offset_right = 430.0
offset_bottom = 160.0
theme = ExtResource("2_theme")
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Overlay/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "보스 · 2D 목업 보드"

[node name="Description" type="Label" parent="Overlay/Content"]
layout_mode = 2
text = "보스 규칙은 같은 차원 독립 보드 계약에 연결"

[node name="NextButton" type="Button" parent="Overlay/Content"]
layout_mode = 2
text = "보스 웨이브 클리어 처리"
